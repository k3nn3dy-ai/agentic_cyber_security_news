# AI API Keys
# Required: Anthropic API key for Claude models (Haiku and Sonnet)
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Required: Serper API key for Google search functionality
# Get free key at: https://serper.dev/
SERPER_API_KEY=your_serper_api_key_here

# Optional: AgentOps key for monitoring (currently commented out in code)
AGENTOPS_KEY=your_agentops_api_key_here

# Alternative AI Provider Keys (if switching from Anthropic)
# OPENAI_API_KEY=your_openai_api_key_here

# CrewAI Configuration
# Optional: Set to control verbosity
CREWAI_VERBOSE=false

# Optional: Set telemetry preferences
CREWAI_TELEMETRY=true

# Application Settings
# Optional: Python path for imports
PYTHONPATH=./cyber_security_news/src

# Optional: Logging level
LOG_LEVEL=INFO

# Docker/Production Settings
# Optional: Port for health checks
HEALTH_CHECK_PORT=8080

# Optional: Data persistence paths
DATA_PATH=./data
REPORTS_PATH=./reports
LOGS_PATH=./logs